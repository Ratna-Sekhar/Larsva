# ── LLM ──
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5.6-terra
LLM_FALLBACK_MODEL=              # optional, e.g. gpt-5.6-sol
REASONING_EFFORT=medium           # low | medium | high
MAX_OUTPUT_TOKENS=16000           # includes reasoning tokens

# ── Image detail for the LLM call ──
IMAGE_DETAIL_FLAGGED=high
IMAGE_DETAIL_DEFAULT=auto

# ── PDF limits ──
MAX_PAGES=20
MAX_UPLOAD_MB=10
RENDER_DPI=150
MAX_IMAGE_EDGE_PX=1568

# ── Rate limiting & cost ──
DAILY_SPEND_CAP_USD=50.0
RATE_LIMIT_PER_IP_PER_HOUR=20

# ── Privacy ──
RETAIN_RESULTS=false
ALLOWED_ORIGINS=https://larsva.com
